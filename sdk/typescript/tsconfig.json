  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "noEmitOnError": true,
    "rootDir": ".",
    "outDir": "dist",
    "skipLibCheck": false
  },
  "include": ["src/**/*.ts", "gen/**/*.ts"]
}
