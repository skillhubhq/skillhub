{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkillHub evaluation case suite",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "skillhub.cases.v1"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "input": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "expected": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "id",
          "input",
          "expected"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "name",
    "version",
    "cases"
  ]
}
