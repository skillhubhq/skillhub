{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkillHub external evaluation report",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "skillhub.evaluation.v1"
    },
    "skill_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "skillhub.cases.v1"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "input": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "expected": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "required": [
              "id",
              "input",
              "expected"
            ]
          }
        }
      },
      "required": [
        "schema_version",
        "name",
        "version",
        "cases"
      ]
    },
    "agent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "runner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "settings": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "executed_at": {
      "type": "string",
      "format": "date-time"
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "error",
              "skipped"
            ]
          },
          "observed": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "baseline": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "enum": [
                  "pass",
                  "fail",
                  "error",
                  "skipped"
                ]
              },
              "observed": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              }
            },
            "required": [
              "status",
              "observed"
            ]
          }
        },
        "required": [
          "case_id",
          "status",
          "observed"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "skill_digest",
    "suite",
    "agent",
    "model",
    "runner",
    "settings",
    "executed_at",
    "results"
  ]
}
