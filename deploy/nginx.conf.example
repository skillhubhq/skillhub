# Include in an existing TLS server block for skills.example.com.
# Keep certificate provisioning and renewal in the existing proxy configuration.
location / {
    proxy_pass http://127.0.0.1:8080;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    # Overwrite client-supplied forwarding headers at this directly exposed edge.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    client_max_body_size 32m;
    proxy_connect_timeout 5s;
    proxy_read_timeout 65s;
    proxy_send_timeout 65s;
    proxy_buffering off;
}
